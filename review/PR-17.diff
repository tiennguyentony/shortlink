diff --git a/src/shortlink/routes/redirect.py b/src/shortlink/routes/redirect.py
index 11a6b25..4d63dde 100644
--- a/src/shortlink/routes/redirect.py
+++ b/src/shortlink/routes/redirect.py
@@ -24,5 +24,6 @@ def visit_from(request: Request, trust_proxy_headers: bool) -> Visit:
 def follow(code: str, request: Request, services: ServicesDep, settings: SettingsDep):
     target = services.redirects.resolve(code)
     services.clicks.record(target.link_id, visit_from(request, settings.trust_proxy_headers))
-    # 302, not 301: browsers cache 301s forever (ADR-002).
-    return RedirectResponse(target.target_url, status_code=302, headers={"Cache-Control": "private, no-cache"})
+    # 301 is the correct status for a short link and lets browsers and CDNs
+    # cache the redirect, which takes load off the API.
+    return RedirectResponse(target.target_url, status_code=301, headers={"Cache-Control": "public, max-age=86400"})
